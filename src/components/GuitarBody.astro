---
import BaseHead from "./BaseHead.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, ARTISTS_GUITAR } from "../consts";
import { getCollection } from "astro:content";
import { dateFormat } from "../utils";
import RelatedSongAd from "./RelatedSongAd.astro";
const { name } = Astro.props;
const posts: any = (await getCollection(name)).sort(
  (a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const singer = ARTISTS_GUITAR.find((el: any) => el.value === name);

const fiveSongs = posts.length >= 5 ? posts.slice(0, 5) : posts;
const descs = fiveSongs.map((el: any) => el.data.description);
const concatenatedDescs = descs.join(", ");

const today = new Date();
---

<head>
  <BaseHead
    title={`${singer?.name} Guitar Chords - ${SITE_TITLE} Hmoob` ||
      SITE_TITLE + " Hmoob"}
    image={posts[0]?.data?.heroImage}
    description={singer?.description + ", " + concatenatedDescs ||
      SITE_DESCRIPTION}
  />
</head>
<body>
  <Header />
  <main class="content-page min-h-screen">
    <section class="content-hero">
    <div>
      <img
        src={posts[0]?.data.heroImage}
        alt={singer?.name}
        class="artist-cover"
      />
    </div>
    <div>
    <span class="content-kicker">Guitar collection</span>
    <h1>{singer?.name}</h1>
    <p class="content-meta">{posts.length} chord guides in this collection</p>
    </div>
    </section>
    <h2 class="sr-only">{singer?.name} Songs</h2>
    <h3 class="sr-only">{singer?.name} Lyrics</h3>
    <h4 class="sr-only">
      {today.getFullYear()}/{today.getMonth() - 1}/{today.getDate()}
    </h4>
    <section class="reading-card">
      <div class="section-heading"><div><span class="eyebrow">Play along</span><h2>Guitar chords</h2></div></div>
      <ul class="artist-list">
        {
          posts.map((post: any) => (
            <li class="border-b pb-2 my-2">
              <a href={`/${name}/${post.id}/`} class="hover:underline">
                <h4 class="text-xl md:text-2xl">{post.data.title}</h4>
              </a>
              <div class="text-sm">{dateFormat(post.data.pubDate)}</div>
            </li>
          ))
        }
      </ul>
    </section>
    <RelatedSongAd />
  </main>
  <Footer />
</body>
